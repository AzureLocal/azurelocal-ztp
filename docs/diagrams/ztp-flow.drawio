<mxfile host="drawio"><diagram id="ztp-flow" name="ZTP flow"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="2300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Azure Local ZTP: from the environment file to machines ready to join a cluster" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="lane0" value="Operator" style="swimlane;html=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="0" y="45" width="300" height="2075" as="geometry"/></mxCell>
<mxCell id="lane1" value="Management host" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="45" width="300" height="2075" as="geometry"/></mxCell>
<mxCell id="lane2" value="Azure" style="swimlane;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="45" width="300" height="2075" as="geometry"/></mxCell>
<mxCell id="lane3" value="Machine and BMC" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900" y="45" width="300" height="2075" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;1. Fill in the environment file&lt;/b&gt;&lt;br&gt;Machines: name, serial or service tag, BMC address, management MAC and IP. Network, DNS, NTP. Subscription, resource group, site, provisioning ISO and OS build. Key Vault secret references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="105" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;2. Download the SBE from the OEM&lt;/b&gt;&lt;br&gt;The package (.zip), its metadata (.xml) and the OEM discovery manifest (.xml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;3. Set ztp.node_preparation.sbe_bundle&lt;/b&gt;&lt;br&gt;to the folder holding those files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="315" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;4. Run Invoke-ZtpEnvironment.ps1&lt;/b&gt;&lt;br&gt;-InfrastructureFile &amp;lt;file&amp;gt;: plan first, then -Execute. No other input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;Validate the environment file and stop if it fails. Write ZTP settings, machine list and Bicep parameters. Read BMC login and admin secret from Key Vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="525" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s6" value="&lt;b&gt;Resolve&lt;/b&gt;&lt;br&gt;Provisioning ISO from the environment file. SBE pinned to the supplied package: SHA-256 against the OEM manifest, checked against the pinned OS build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="630" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s7" value="&lt;b&gt;Media&lt;/b&gt;&lt;br&gt;Build one virtual USB image per machine from the provisioning ISO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="735" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s8" value="&lt;b&gt;Boot&lt;/b&gt;&lt;br&gt;SMB share for the BMCs only. Redfish attaches each image read-write and boots all machines from it at once. Stops if one boots its installed OS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="840" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s9" value="&lt;b&gt;Bootstrap&lt;/b&gt;&lt;br&gt;Maintenance environment installs and writes the FDO ownership voucher to the image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="945" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s10" value="&lt;b&gt;Vouchers&lt;/b&gt;&lt;br&gt;Read each machine&apos;s voucher from the image, check it matches the serial, eject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="1050" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s11" value="&lt;b&gt;Azure&lt;/b&gt;&lt;br&gt;Bicep: site, configuration, role assignments, edge machine claim. The service creates each Arc machine and names it &amp;lt;device-id&amp;gt;-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="1155" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s12" value="&lt;b&gt;OS install&lt;/b&gt;&lt;br&gt;Machine calls home. ProvisionOs downloads and installs the pinned OS build, then the Arc agent and extensions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="1260" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s13" value="&lt;b&gt;Ready&lt;/b&gt;&lt;br&gt;Wait for Ready to cluster: Provisioned, job succeeded, Arc Connected, extensions done. One automatic resubmit on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="1365" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s14" value="&lt;b&gt;Handoff&lt;/b&gt;&lt;br&gt;Each machine&#39;s arcMachineResourceId and the cluster inputs, with the SBE values for the ARM template" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="1470" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s15" value="&lt;b&gt;Prepare, gates 1 and 2&lt;/b&gt;&lt;br&gt;Azure still reports Ready. The machine accepts the administrator secret ZTP set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="1575" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s16" value="&lt;b&gt;Prepare on the machine, as SYSTEM&lt;/b&gt;&lt;br&gt;All machines at once. SBE drivers by hardware ID, SBE to C:\SBE, deployment admin, static IP on the management MAC, one default gateway, DNS and time from the environment file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="1680" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s17" value="&lt;b&gt;Prepare, gate 3&lt;/b&gt;&lt;br&gt;Machine reports success. Restarts once if a driver or Windows asks, and waits for it to return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="1785" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s18" value="&lt;b&gt;Prepare, gate 4&lt;/b&gt;&lt;br&gt;Checked on the machine: address, gateway, drivers, C:\SBE, admin, time. Then Azure reports Ready again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="1890" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="s19" value="&lt;b&gt;Ready to join the cluster&lt;/b&gt;&lt;br&gt;Ready for Validate. Next: AD preparation, ARM Validate, then Deploy" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#60a917;strokeColor=#2D7600;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1995" width="1160" height="78" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="gate: environment file valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="gate: image attached read-write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="gate: voucher written" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="gate: valid voucher per machine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="gate: claim accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s11" target="s12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s12" target="s13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="gate: Ready to cluster" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s13" target="s14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s14" target="s15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" value="gate: signed in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s15" target="s16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e16" value="gate: task finished" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s16" target="s17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e17" value="gate: machine back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s17" target="s18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e18" value="gate: all checks pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s18" target="s19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n1" value="Once per environment, before the first run: give the automation identity Contributor and Role Based Access Control Administrator on the resource group, and secret read on the Key Vault. Secrets live in the Key Vault the environment file names" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="n2" value="The management host is any machine that reaches the BMCs over Redfish, serves SMB to them, and reaches Azure. Sonar can follow every stage, read-only" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="620" y="210" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="n3" value="A gate that fails or times out stops the run with the reason. A rerun resumes and skips finished steps" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="260" height="78" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
