<mxfile host="drawio"><diagram id="ztp-flow-to-handoff" name="ZTP flow to handoff"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="2300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Azure Local ZTP: from infrastructure.yml to provisioned machines (handoff)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="lane0" value="Operator" style="swimlane;html=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="0" y="45" width="300" height="2100" as="geometry"/></mxCell>
<mxCell id="lane1" value="Management host" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="45" width="300" height="2100" as="geometry"/></mxCell>
<mxCell id="lane2" value="Azure" style="swimlane;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="45" width="300" height="2100" as="geometry"/></mxCell>
<mxCell id="lane3" value="Machine and BMC" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900" y="45" width="300" height="2100" as="geometry"/></mxCell>

<mxCell id="s1" value="&lt;b&gt;1. Fill in infrastructure.yml&lt;/b&gt;&lt;br&gt;The master file every tool reads. Machines: name, serial, BMC, management NIC by MAC and its IP. Network: subnet, gateway, DNS, VLAN, how the IP is assigned (static, DHCP reservation, DHCP), who sets a static IP (static_method) and the provisioning DHCP range. BIOS: the final settings (bios) and any that differ during the install only (bios_during_provisioning). Subscription, resource group, site, ISO and OS build. Media and evidence folders outside any repo. Key Vault references for every secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="105" width="260" height="190" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;2. Run Invoke-ZtpEnvironment.ps1&lt;/b&gt;&lt;br&gt;-InfrastructureFile &amp;lt;file&amp;gt;: plan first, then -Execute. No other input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="260" height="66" as="geometry"/></mxCell>

<mxCell id="n1" value="Once per environment, before the first run: give the automation identity Contributor and Role Based Access Control Administrator on the resource group, and secret read on the Key Vault" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="320" y="105" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="The management host reaches the BMCs over Redfish, serves SMB to them, reaches Azure, and reaches the maintenance environment on TCP 20001 (each machine's maintenance address, or the provisioning DHCP range). Sonar can follow every stage, read-only" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="620" y="105" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="n3" value="A gate that fails or times out stops the run with the reason. A rerun resumes and skips finished stages (-From &amp;lt;stage&amp;gt;)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="620" y="215" width="240" height="56" as="geometry"/></mxCell>

<mxCell id="start" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;Validate the file (the toolkit's schema 5 rules when present) and stop if it fails. Write the ZTP settings, machine list and Bicep parameters. Read the BMC, admin and maintenance secrets from Key Vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="420" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="resolve" value="&lt;b&gt;Resolve&lt;/b&gt;&lt;br&gt;Maintenance ISO: newest GA or the pinned build, checked by SHA-256, cached in the media folder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="540" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="media" value="&lt;b&gt;Media&lt;/b&gt;&lt;br&gt;One virtual USB image per machine from the ISO, with the maintenance login password preset from Key Vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="630" width="260" height="62" as="geometry"/></mxCell>

<mxCell id="boot" value="&lt;b&gt;Boot&lt;/b&gt;&lt;br&gt;BIOS over Redfish: bios with bios_during_provisioning merged over it (the temporary values win, for example an FC HBA slot off). Only what differs, applied on reset. The original value of each changed setting is saved. SMB share for the BMCs only. Each image mounted on the virtual USB read-write, one-time boot, reset. Stops if a machine boots its installed OS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="720" width="260" height="162" as="geometry"/></mxCell>
<mxCell id="bootstrap" value="&lt;b&gt;Bootstrap&lt;/b&gt;&lt;br&gt;The maintenance environment installs, takes DHCP on its ports to reach Azure, and writes the FDO ownership voucher to the image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="912" width="260" height="70" as="geometry"/></mxCell>

<mxCell id="vouchers" value="&lt;b&gt;Vouchers&lt;/b&gt;&lt;br&gt;Read each machine's voucher from the image, check it matches the serial, eject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="1012" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="device" value="&lt;b&gt;Device&lt;/b&gt; (static IP, static_method device)&lt;br&gt;In the maintenance environment, before the claim. Find each machine: scan the provisioning DHCP range on TCP 20001 and match its management MAC (GetNetworkAdapters). Set the static management IP, mask, gateway, DNS and VLAN on that port through the Configurator service (SetArcBootstrapDeviceConfiguration), then read it back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="1102" width="260" height="148" as="geometry"/></mxCell>

<mxCell id="azure" value="&lt;b&gt;Azure&lt;/b&gt;&lt;br&gt;Bicep: site and its settings (network Automatic with static_method device, time, Key Vault), role assignments, and the claim of each machine with its voucher. The claim carries no Manual adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="1280" width="260" height="95" as="geometry"/></mxCell>
<mxCell id="osinstall" value="&lt;b&gt;Registration and OS install&lt;/b&gt;&lt;br&gt;The machine calls home (FDO handshake with the onboarding service) and connects to Arc. ProvisionOs downloads and installs the OS, then the Arc agent and extensions. The service names the Arc machine &amp;lt;device-id&amp;gt;-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="1405" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="ready" value="&lt;b&gt;Ready&lt;/b&gt;&lt;br&gt;Wait for Provisioned: job succeeded, Arc Connected, extensions done. One automatic resubmit on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="1535" width="260" height="70" as="geometry"/></mxCell>

<mxCell id="network" value="&lt;b&gt;Network&lt;/b&gt;&lt;br&gt;After the OS install, read each machine's per-NIC report from Azure. Is the management IP on the port with the management MAC, as the file says? If not, move it there with Azure's per-NIC ApplyConfiguration job, then check again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="1635" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="restore" value="&lt;b&gt;Restore&lt;/b&gt;&lt;br&gt;Set each bios_during_provisioning setting back to its final bios value (or the saved original). Restart through Redfish, wait until the BIOS reports the values, then wait until Arc is Connected and the machine is ready to cluster again. Nothing to do without bios_during_provisioning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="1765" width="260" height="115" as="geometry"/></mxCell>
<mxCell id="handoff" value="&lt;b&gt;Handoff&lt;/b&gt; (schema 2)&lt;br&gt;Only what Azure generated: each machine's Arc machine name and resource ID, the OS build installed, managementAddressVerified (from Network) and biosRestored (from Restore). Plus the cluster inputs. Settings stay in infrastructure.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="1910" width="260" height="110" as="geometry"/></mxCell>

<mxCell id="done" value="&lt;b&gt;ZTP ends here: machines provisioned&lt;/b&gt;&lt;br&gt;Provisioned in Azure, Arc-connected, management IP on the management NIC as infrastructure.yml says, BIOS on its final settings" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#60a917;strokeColor=#2D7600;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="2055" width="1160" height="66" as="geometry"/></mxCell>
<mxCell id="next" value="&lt;b&gt;Next, not part of ZTP: OS configuration, then the cluster&lt;/b&gt;&lt;br&gt;OEM drivers and the SBE (C:\SBE), DHCP and gateways off on the other NICs, DNS and time, the deployment admin. Find NICs by MAC: ZTP-built machines name them Port0 to Port6. Follow &lt;a href=&quot;https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-03-os-configuration/&quot;&gt;azurelocal.cloud: Phase 03 OS configuration&lt;/a&gt;, then AD preparation, ARM Validate and Deploy&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-03-os-configuration/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="2185" width="1160" height="96" as="geometry"/></mxCell>

<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="start"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="gate: file valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="start" target="resolve"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="resolve" target="media"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="media" target="boot"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="gate: image attached read-write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="boot" target="bootstrap"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="gate: voucher written" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="bootstrap" target="vouchers"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="gate: valid voucher per machine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="vouchers" target="device"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="gate: static IP on the management port" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="device" target="azure"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="gate: claim accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="azure" target="osinstall"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="osinstall" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="gate: Provisioned" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="ready" target="network"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="gate: management IP verified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="network" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="gate: Connected, ready to cluster" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="restore" target="handoff"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.371;entryY=0;" edge="1" parent="1" source="handoff" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e16" value="handoff file and infrastructure.yml" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;dashed=1;" edge="1" parent="1" source="done" target="next"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
