# ═══════════════════════════════════════════════════════════════════════════
# Azure Local ZTP — Cluster Reference
# ═══════════════════════════════════════════════════════════════════════════
#
# This is the ONLY file you need to edit for a new deployment.
# Fill in the values below, then run Pipeline 1 (ZTP Config Bootstrap)
# to generate the full cluster-config.md and environment config files.
#
# INSTRUCTIONS:
#   1. Copy this file to: config/cluster-reference.env
#   2. Fill in ALL required fields (marked REQUIRED)
#   3. Adjust optional fields as needed (sensible defaults provided)
#   4. Commit config/cluster-reference.env to your private fork
#   5. Trigger the "ZTP Config Bootstrap" pipeline
#
# NOTES:
#   - Lines starting with # are comments
#   - Do not quote values (no "quotes" around values)
#   - Comma-separated lists: no spaces after commas
#   - [SECURED] values should be stored in Azure Key Vault
#
# ═══════════════════════════════════════════════════════════════════════════

# ── Azure Identity (REQUIRED) ────────────────────────────────────────────

# Azure AD tenant ID (GUID)
AZURE_TENANT_ID=

# Azure AD primary domain (e.g., contoso.cloud)
AZURE_PRIMARY_DOMAIN=

# Azure AD tenant directory (e.g., contoso.onmicrosoft.com)
AZURE_TENANT_DIRECTORY=

# ── Azure Subscription (REQUIRED) ────────────────────────────────────────

# Management subscription ID (GUID) — where cluster resources are deployed
AZURE_SUBSCRIPTION_ID=

# Workload subscription ID (GUID) — for tenant workloads (can be same as above)
AZURE_WORKLOAD_SUBSCRIPTION_ID=

# Azure region for deployment (e.g., eastus, westus2, westeurope)
AZURE_REGION=eastus

# ── Cluster Identity (REQUIRED) ─────────────────────────────────────────

# Cluster name — used as base for all naming conventions
# Example: tplabs-clus01, contoso-azl01, site1-clus01
CLUSTER_NAME=

# Cluster resource group name
# Leave empty to auto-generate: rg-<cluster_name>-<region_short>-01
CLUSTER_RESOURCE_GROUP=

# Number of physical nodes (2, 4, 8, or 16)
NODE_COUNT=4

# ── Domain Configuration (REQUIRED) ──────────────────────────────────────

# Active Directory fully qualified domain name
DOMAIN_FQDN=

# Active Directory NetBIOS name
DOMAIN_NETBIOS=

# ── Domain Controllers (REQUIRED) ────────────────────────────────────────

# Primary domain controller IP address
DC_01_IP=

# Secondary domain controller IP address
DC_02_IP=

# ── Physical Nodes — iDRAC (REQUIRED) ────────────────────────────────────
# Comma-separated list of iDRAC management IPs, one per node, in order.
# These MUST be reachable from the runner/share server.

IDRAC_IPS=

# ── Physical Nodes — Hostnames (REQUIRED) ────────────────────────────────
# Comma-separated list of hostnames, same order as iDRAC IPs.
# Example: site1-n01,site1-n02,site1-n03,site1-n04

NODE_HOSTNAMES=

# ── Physical Nodes — Management IPs (REQUIRED) ──────────────────────────
# Comma-separated list of management network IPs, same order as iDRAC IPs.

NODE_MGMT_IPS=

# ── Key Vault (REQUIRED) ─────────────────────────────────────────────────

# Platform Key Vault name — stores iDRAC credentials and other secrets
KEYVAULT_PLATFORM_NAME=

# Key Vault resource group (leave empty to use cluster resource group)
KEYVAULT_RESOURCE_GROUP=

# Name of the Key Vault secret containing iDRAC credentials
# Format inside KV: username:password
IDRAC_SECRET_NAME=idrac-credentials

# ── GitHub Actions Runner (REQUIRED) ──────────────────────────────────────
# The runner is the server where pipelines execute, the repo is cloned,
# and (by default) the ZTP file share is hosted.

# Deployment mode: deploy_azure_vm | existing_azure_vm | existing_onprem | manual
RUNNER_DEPLOYMENT_MODE=existing_azure_vm

# Runner server IP address (REQUIRED for existing_* modes)
# Must be reachable from iDRAC OOB network for virtual media mounts
RUNNER_IP_ADDRESS=

# Windows computer name (15 character max for AD)
RUNNER_HOSTNAME=

# GitHub repo clone URL (full URL — supports forks and GHE)
RUNNER_REPO_URL=

# GitHub runner labels (comma-separated)
RUNNER_LABELS=self-hosted,Windows,ztp

# ── Share Configuration (REQUIRED) ───────────────────────────────────────
# Share runs on the runner by default. To use a separate share server,
# set SHARE_SERVER_IP to a different IP than RUNNER_IP_ADDRESS.

# Share server IP (leave empty to use RUNNER_IP_ADDRESS)
SHARE_SERVER_IP=

# Local path on the share server for ZTP files
SHARE_PATH=C:\share\ztp

# SMB share name (what iDRAC sees in the UNC path)
SHARE_NAME=ztp

# ── Runner VM Deployment (only when RUNNER_DEPLOYMENT_MODE=deploy_azure_vm) ──
# Leave these empty if using an existing server.

# Azure VM resource name
RUNNER_VM_NAME=

# Azure VM SKU size (4 vCPU / 16 GB min)
RUNNER_VM_SKU=Standard_D4s_v5

# VNet and subnet to deploy into (resource names, not IDs)
RUNNER_VM_VNET=
RUNNER_VM_SUBNET=

# Static private IP for the VM (maps to RUNNER_IP_ADDRESS)
RUNNER_VM_IP=

# ── ZTP Media (OPTIONAL — defaults usually work) ─────────────────────────

# Azure Local maintenance environment version (e.g., 2512, 2602)
MAINTENANCE_VERSION=2512

# Local download directory for ZTP tools
DOWNLOAD_DIRECTORY=C:\AzureLocal\ZTP

# Local extraction directory
EXTRACTED_DIRECTORY=C:\AzureLocal\ZTP\extracted

# ── Networking — OOB (REQUIRED) ──────────────────────────────────────────

# Out-of-Band (iDRAC) network CIDR
OOB_CIDR=

# OOB network gateway
OOB_GATEWAY=

# OOB VLAN ID
OOB_VLAN=

# ── Networking — Management (REQUIRED) ───────────────────────────────────

# Management network CIDR
MGMT_CIDR=

# Management network gateway
MGMT_GATEWAY=

# Management VLAN ID
MGMT_VLAN=

# ── Networking — Compute (OPTIONAL) ─────────────────────────────────────

# Compute network CIDR (leave empty if not used)
COMPUTE_CIDR=

# Compute network gateway
COMPUTE_GATEWAY=

# Compute VLAN ID
COMPUTE_VLAN=

# ── Credentials — iDRAC (REQUIRED) ──────────────────────────────────────
# The actual iDRAC password is stored in Key Vault.
# This is only the username — the pipeline retrieves the password from KV.

IDRAC_USERNAME=

# ── Credentials — Deployment Accounts (OPTIONAL) ────────────────────────
# Defaults are generated from cluster name if left empty.

# Local administrator username on cluster nodes
LOCAL_ADMIN_USERNAME=administrator

# LCM deployment account name (leave empty to auto-generate)
LCM_DEPLOYMENT_ACCOUNT=

# Provisioning account name
PROVISIONING_ACCOUNT=

# ── Share Access Account (OPTIONAL) ─────────────────────────────────────
# Service account created on the share server for iDRAC share access

SHARE_USERNAME=svc_idrac_share

# ═══════════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
#
# After filling in this file:
#   1. Save as config/cluster-reference.env
#   2. git add config/cluster-reference.env
#   3. git commit -m "Add cluster reference for <your-cluster-name>"
#   4. git push
#   5. Go to GitHub Actions → "ZTP Config Bootstrap" → Run workflow
#
# The bootstrap pipeline will:
#   - Generate config/cluster/cluster-config.md with all 250+ variables
#   - Generate config/environment.yaml and config/environment.json
#   - Validate configuration completeness
#   - Optionally run hardware discovery to populate MAC addresses
#
# ═══════════════════════════════════════════════════════════════════════════
