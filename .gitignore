# Files of the retired configuration layer. Nothing reads them any more; they stay ignored so a leftover copy with real
# values can't be committed. The configuration is the master infrastructure.yml, kept outside the repository.
config/environment.yaml
config/environment.json
config/cluster-reference.env
config/cluster/cluster-config.md

# Temporary files
*.tmp
*.temp
.cache/

# Docker
.dockerignore
.claude/logs/
.claude/settings.local.json

# Simplified provisioning: real node lists, parameters, vouchers and images stay local (the *.example.* files are committed)
/nodes.json
config/simplified-provisioning/*.json
!config/simplified-provisioning/*.example.json
!config/simplified-provisioning/*.schema.json
scripts/simplified-provisioning/bicep/*.parameters.json
!scripts/simplified-provisioning/bicep/*.example.parameters.json
*.pem
*.img

# Invoke-ZtpProvisioning.ps1 run state (local progress only)
*.state.json
*.state.json.tmp

# Run outputs of the automated bootstrap (events, handoff, generated Sonar config, downloads): local only
ztp-events.jsonl
ztp-handoff.json
ztp-cluster-inputs.yaml
ztp-cluster-inputs.json
ztp-sonar.config.json
